APP_NAME=Taskon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# O prazo do card é gravado NESTE fuso — o <input type="datetime-local"> manda
# uma data sem fuso e o Laravel a interpreta aqui. Também é o fuso em que o
# resumo diário decide o que é "hoje" e a que horas ele sai.
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco CENTRAL da infra do Traefik (container 'mariadb'), acessado de FORA do
# Docker — a infra publica o MariaDB em 127.0.0.1:3309.
# Dentro do container o docker-compose.yml sobrescreve para mariadb:3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3309
DB_DATABASE=taskon
DB_USERNAME=dev
DB_PASSWORD=dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit CENTRAL da infra — todo e-mail (ex.: link de recuperação de senha)
# cai em https://mail.localhost e nada sai para a internet.
#
# Para entregar de verdade pelo Resend: MAIL_MAILER=resend, preencha
# RESEND_API_KEY e use um MAIL_FROM_ADDRESS de domínio verificado no painel
# deles. Enquanto o domínio não estiver verificado, o Resend só aceita
# onboarding@resend.dev como remetente e só entrega para o e-mail da conta.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="taskon@localhost"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# Resumo diário (php artisan taskon:daily-digest)
DIGEST_AT=07:00
DIGEST_HORIZON_DAYS=7

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
