# -----------------------------------------------------------------------------
# Taskon — variáveis de ambiente
#
# Local: copie para .env.local (o Next carrega .env.local por cima de .env).
# Vercel: cadastre em Project Settings › Environment Variables.
# -----------------------------------------------------------------------------

APP_NAME=Taskon

# URL pública, usada nos links dos e-mails. Na Vercel pode ficar vazia: o app
# usa o domínio de produção que a própria Vercel injeta.
APP_URL=http://localhost:3000

# O prazo do card é interpretado NESTE fuso (o <input type="datetime-local">
# manda uma data sem fuso), e é nele que o painel e o resumo decidem o que é
# "hoje". O servidor da Vercel roda em UTC — por isso o fuso é explícito.
APP_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Banco
#
# Postgres (Neon pelo Marketplace da Vercel, ou Supabase). Use a URL do POOLER
# (Neon: a "pooled"; Supabase: a do Supavisor em modo transaction, porta 6543).
#
# Sem DATABASE_URL, o app usa o PGlite: um Postgres local, em arquivo, em
# ./.data/pglite — nada para instalar no desenvolvimento.
# -----------------------------------------------------------------------------
DATABASE_URL=
# PGLITE_DIR=./.data/pglite
# DATABASE_POOL_MAX=5

# -----------------------------------------------------------------------------
# Sessão
# -----------------------------------------------------------------------------
# Minutos de inatividade até a sessão sem "lembrar de mim" expirar.
SESSION_LIFETIME=120
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Administração (/admin)
#
# O admin NATIVO é a conta com um destes e-mails (separados por vírgula) — e
# só depois de confirmar que o e-mail é dela (link de confirmação no próprio
# painel, ou uma redefinição de senha concluída). Sem a variável, vale
# victorgabriel08fs@gmail.com. No desenvolvimento, dá para usar uma conta do
# seed: NATIVE_ADMIN_EMAILS=victor@taskon.test
# -----------------------------------------------------------------------------
# NATIVE_ADMIN_EMAILS=victorgabriel08fs@gmail.com

# -----------------------------------------------------------------------------
# E-mail
#
# MAIL_MAILER: resend | smtp | log
#   - resend: produção (precisa de RESEND_API_KEY);
#   - smtp:   Mailpit no desenvolvimento (MAIL_HOST=127.0.0.1, MAIL_PORT=1025);
#   - log:    só imprime no terminal (padrão quando não há RESEND_API_KEY).
#
# Enquanto o domínio não estiver verificado no painel do Resend, a API só aceita
# onboarding@resend.dev como remetente e só entrega para o e-mail da conta.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=Taskon
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Agendamentos (Vercel Cron — ver vercel.json, que está em UTC)
#
# Estes horários são os que a TELA mostra, no fuso do app. Se mudar aqui, mude
# o "schedule" correspondente no vercel.json (07:00 em São Paulo = 10:00 UTC).
# -----------------------------------------------------------------------------
DIGEST_AT=07:00
DIGEST_HORIZON_DAYS=7
AUTO_ARCHIVE_AT=03:00

# A Vercel manda "Authorization: Bearer $CRON_SECRET" ao chamar os crons.
# Gere com: openssl rand -hex 32
CRON_SECRET=
